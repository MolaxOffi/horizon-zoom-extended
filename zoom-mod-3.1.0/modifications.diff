+    fn compute_fov(&self, _: &dyn ClientHost, event: &mut ComputeFovEvent) {
+        // Its own statement: no host call is made with the lock held.
+        let extra = self.state().extra();
+        if let Some(extra) = extra {
+            event.degrees = (event.degrees / extra).max(MIN_FOV);
+        }
+    }
+
+    /// Slower turning goes on past the game's own zoom cap, as it does below it.
+    fn calculate_player_turn(&self, _: &dyn ClientHost, event: &mut CalculatePlayerTurnEvent) {
+        let extra = self.state().extra_turn();
+        if let Some(extra) = extra {
+            event.mouse_sensitivity /= f64::from(extra);
+        }
+    }
